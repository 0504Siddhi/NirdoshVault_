{
  "name": "nirdosh-vault-api",
  "version": "1.0.0",
  "description": "Nirdosh Vault — AI-powered Consensus Identity Engine API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node scripts/copy-runtime-assets.js",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "node -r ts-node/register src/services/consensusService.test.ts && node -r ts-node/register src/services/extractionService.test.ts && node -r ts-node/register src/services/qualityService.test.ts && node -r ts-node/register src/services/extractionService.retry.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@types/morgan": "^1.9.10",
    "@types/winston": "^2.4.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "file-type": "^22.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.4",
    "uuid": "^10.0.0",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
